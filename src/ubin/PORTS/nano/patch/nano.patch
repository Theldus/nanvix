 	goto cleanup_and_exit;
 
 #ifndef NANO_TINY
@@ -2475,18 +2475,25 @@ char *real_dir_from_tilde(const char *buf)
 	    get_homedir();
 	    tilde_dir = mallocstrcpy(NULL, homedir);
 	} else {
+#ifndef __nanvix__
 	    const struct passwd *userdata;
+#endif
 
 	    tilde_dir = mallocstrncpy(NULL, buf, i + 1);
 	    tilde_dir[i] = '\0';
 
+#ifndef __nanvix__
