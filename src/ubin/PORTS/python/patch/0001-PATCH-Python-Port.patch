diff --git a/Modules/pwdmodule.c b/Modules/pwdmodule.c
index 810427a229..d049397a4d 100644
--- a/Modules/pwdmodule.c
+++ b/Modules/pwdmodule.c
@@ -125,7 +125,12 @@ pwd_getpwuid(PyObject *module, PyObject *uidobj)
                          "getpwuid(): uid not found");
         return NULL;
     }
+#ifndef __nanvix__
     if ((p = getpwuid(uid)) == NULL) {
+#else
+    {
+        p = NULL;
+#endif
         PyObject *uid_obj = _PyLong_FromUid(uid);
         if (uid_obj == NULL)
             return NULL;
@@ -161,7 +166,12 @@ pwd_getpwnam_impl(PyObject *module, PyObject *arg)
     /* check for embedded null bytes */
     if (PyBytes_AsStringAndSize(bytes, &name, NULL) == -1)
         goto out;
+#ifndef __nanvix__
     if ((p = getpwnam(name)) == NULL) {
+#else
+    {
+        p = NULL;
+#endif
         PyErr_Format(PyExc_KeyError,
                      "getpwnam(): name not found: %R", arg);
         goto out;
diff --git a/Modules/timemodule.c b/Modules/timemodule.c
index a963bb1dd1..2939cc1958 100644
--- a/Modules/timemodule.c
+++ b/Modules/timemodule.c
@@ -1463,12 +1463,18 @@ pysleep(_PyTime_t secs)
         if (_PyTime_AsTimeval(secs, &timeout, _PyTime_ROUND_CEILING) < 0)
             return -1;
 
+#ifndef __nanvix__
         Py_BEGIN_ALLOW_THREADS
+
         err = select(0, (fd_set *)0, (fd_set *)0, (fd_set *)0, &timeout);
         Py_END_ALLOW_THREADS
 
         if (err == 0)
             break;
+#else
+        sleep(timeout.tv_sec);
+        break;
+#endif
 
         if (errno != EINTR) {
             PyErr_SetFromErrno(PyExc_OSError);
