     {
@@ -1230,6 +1235,11 @@ initstdio(void)
     errors = _Py_StandardStreamErrors;
     if (!encoding || !errors) {
         pythonioencoding = Py_GETENV("PYTHONIOENCODING");
+#ifdef __nanvix__
+        if (!pythonioencoding) {
+            pythonioencoding = "UTF-8";
+        }
+#endif
         if (pythonioencoding) {
             char *err;
             pythonioencoding = _PyMem_Strdup(pythonioencoding);
diff --git a/Python/pystate.c b/Python/pystate.c
index 71494daa47..8baf66c99e 100644
--- a/Python/pystate.c
+++ b/Python/pystate.c
@@ -950,6 +950,27 @@ PyGILState_Release(PyGILState_STATE oldstate)
         PyEval_SaveThread();
 }
 
+#else /* ! WITH_THREAD. */
+
+/* I dont know what to do here....... just defining to have something */
+PyThreadState *
+PyGILState_GetThisThreadState(void)
+{
+    return NULL;
+}
+
+PyGILState_STATE
+PyGILState_Ensure(void)
+{
+    return PyGILState_LOCKED;
+}
+
+void
+PyGILState_Release(PyGILState_STATE oldstate)
+{
+    ((void)oldstate);
+}
+
 #endif /* WITH_THREAD */
 
 #ifdef __cplusplus
diff --git a/Python/pytime.c b/Python/pytime.c
index 19fdb55b06..74336d5c29 100644
--- a/Python/pytime.c
+++ b/Python/pytime.c
@@ -667,6 +667,7 @@ _PyTime_GetSystemClockWithInfo(_PyTime_t *t, _Py_clock_info_t *info)
 static int
 pymonotonic(_PyTime_t *tp, _Py_clock_info_t *info, int raise)
 {
+#if !defined(__nanvix__)
 #if defined(MS_WINDOWS)
     ULONGLONG ticks;
     _PyTime_t t;
@@ -760,6 +761,18 @@ pymonotonic(_PyTime_t *tp, _Py_clock_info_t *info, int raise)
     }
     if (_PyTime_FromTimespec(tp, &ts, raise) < 0)
         return -1;
+#endif
+#else
+    time_t time_s;
+    time(&time_s);
+    if (info) {
+        info->monotonic = 0;
+        info->implementation = "gettimeofday()";
+        info->adjustable = 1;
+        info->resolution = 1e-6;
+    }
+    *tp = time_s * SEC_TO_NS;
+    return 0; /* __nanvix__. */
 #endif
     return 0;
 }
diff --git a/Python/random.c b/Python/random.c
index d4747d61eb..6a762105fd 100644
--- a/Python/random.c
+++ b/Python/random.c
@@ -478,6 +478,10 @@ lcg_urandom(unsigned int x0, unsigned char *buffer, size_t size)
 static int
 pyurandom(void *buffer, Py_ssize_t size, int blocking, int raise)
 {
+#ifdef __nanvix__
+    ssize_t i;
+#endif
+
 #if defined(PY_GETRANDOM) || defined(PY_GETENTROPY)
     int res;
 #endif
@@ -514,8 +518,15 @@ pyurandom(void *buffer, Py_ssize_t size, int blocking, int raise)
        ENOSYS or EPERM. Fall back on reading from /dev/urandom. */
 #endif
 
+#ifndef __nanvix__
     return dev_urandom(buffer, size, raise);
+#else
+    /* Yes, the most insecure solution ever =). */
+    for (i = 0; i < size; i++)
+      ((char*)buffer)[i] = rand();
 #endif
+
+#endif /* MS_WINDOWS */
 }
 
