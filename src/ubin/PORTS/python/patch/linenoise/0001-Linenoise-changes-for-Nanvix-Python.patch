+/* Get the address of the start of the last word typed in the line. */
+static char* getWordStart(char *line, size_t len, size_t *ret_len) {
+    char *p;
+    char *start;
+
+    start = line + len - 1;
+    for (p = start; p > line && *p != ' '; p--);
+
+    if (*p == ' ')
+        p++;
+
+    *ret_len = (size_t)(start - p + 1);
+    return p;
+}
+
+/* Update the current line with the given completion.
+ * Takes into account possible spaces and etc, so the completion is _appended_
+ * to the current line, not overwrited. */
+static void updateLine(struct linenoiseState *ls, const char *completion) {
+    char *start;
+    size_t increment, compl_len;
+
+    start      = getWordStart(ls->buf, ls->len, &increment);
+    compl_len  = strlen(completion);
+    increment  = compl_len - increment;
+
+    ls->pos += increment;
+    ls->len  = ls->pos;
+    strncpy(start, completion, ls->buflen - ls->pos);
+}
