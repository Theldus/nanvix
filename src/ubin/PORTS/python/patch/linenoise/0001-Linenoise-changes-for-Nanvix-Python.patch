+/* Convert all tabs to spaces.
+ *
+ * When a line with tabs is saved into the history, the refresh
+ * line method behaves incorrectly, as it assumes a tab char will
+ * not 'skip' <amount-of-chars> and then, not erase the left over
+ * characters when rewriting the line.
+ *
+ * Furthermore, the cursor position is calculated wrong, since
+ * it doesn't account how many chars the cursor have to move in
+ * order to match the 'tab length'.
+ *
+ * So the simplest solution I've found is to just convert all
+ * tabs to spaces. */
+static char *spacifyTabs(const char *line) {
+    struct abuf ab;
+    const char *p;
+    int chars;
+    int tabs;
+
+    /* Count how many tabs and chars, just to avoid realloc'ing
+     * all the time. */
+    for (p = line, tabs = 0, chars = 0; *p != '\0'; p++) {
+        if (*p == '\t')
+            tabs++;
+        else
+            chars++;
+    }
+
+    abInitSize(&ab, chars + (tabs * TAB_SIZE) + 1);
+
+    if (tabs) {
+        for (p = line; *p != '\0'; p++) {
+            if (*p == '\t')
+                abAppend(&ab, "        ", TAB_SIZE);
+            else
+                abAppendChar(&ab, *p);
+        }
+    }
+    else
+        memcpy(ab.b, line, chars);
+
+    /* No need for null terminator, as abInitSize calloc the memory
+     * for us =). */
+    return ab.b;
+}
+
